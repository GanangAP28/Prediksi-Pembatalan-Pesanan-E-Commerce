import os
import warnings
warnings.filterwarnings('ignore')

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import torch
from IPython.display import display

from sklearn.model_selection import train_test_split, GridSearchCV, StratifiedKFold
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.impute import SimpleImputer
from imblearn.over_sampling import SMOTE

from sklearn.neighbors import KNeighborsClassifier
from sklearn.ensemble import RandomForestClassifier
from xgboost import XGBClassifier

from sklearn.metrics import (
    accuracy_score, precision_score, recall_score, f1_score,
    roc_auc_score, confusion_matrix
)

plt.rcParams['figure.figsize'] = (10, 6)
sns.set_theme(style='whitegrid')
print('Seluruh library berhasil diimpor!')

# ============================================================
# 0. LOAD DATASET
# ============================================================
CSV_NAME = 'all_months_clean.csv'

def read_dataset(path):
    """Membaca CSV dengan mendeteksi delimiter titik koma (;) atau koma (,) secara dinamis."""
    try:
        data = pd.read_csv(path, sep=';')
        if data.shape[1] > 1:
            return data
    except Exception:
        pass
    return pd.read_csv(path, sep=',')

csv_filename = CSV_NAME if os.path.exists(CSV_NAME) else None

if csv_filename is None:
    try:
        from google.colab import files
        print(f'File {CSV_NAME} belum ditemukan. Silakan unggah file CSV dataset:')
        uploaded = files.upload()
        if len(uploaded) > 0:
            csv_filename = list(uploaded.keys())[0]
    except Exception as e:
        print('Unggah otomatis tidak tersedia:', e)

if csv_filename is None or not os.path.exists(csv_filename):
    raise FileNotFoundError(f"File dataset '{CSV_NAME}' tidak ditemukan.")

df = read_dataset(csv_filename)

required_cols = ['order_id', 'Status Pesanan', 'Waktu Pesanan Dibuat', 'product_categories']
missing_cols = [c for c in required_cols if c not in df.columns]
if missing_cols:
    raise ValueError(f'Kolom wajib tidak ditemukan: {missing_cols}. Kolom terbaca: {list(df.columns)}')

df = df.rename(columns={
    'Status Pesanan': 'order_status',
    'Alasan Pembatalan': 'cancellation_reason',
    'Waktu Pesanan Dibuat': 'order_time'
})

print(f'File yang dipakai    : {csv_filename}')
print(f'Dimensi Awal Dataset : {df.shape}')
display(df.head())

# ============================================================
# 1. TAHAP 1: DATA PREPROCESSING
# ============================================================
cols_to_drop = [
    'order_id', 'cancellation_reason', 'source_file',
    'Total Pembayaran', 'Ongkos Kirim Dibayar oleh Pembeli',
    'Estimasi Potongan Biaya Pengiriman', 'total_returned_qty'
]
df_clean = df.drop(columns=[c for c in cols_to_drop if c in df.columns]).copy()

# Feature engineering waktu dari order_time
n_before = len(df_clean)
df_clean['order_time'] = pd.to_datetime(df_clean['order_time'], errors='coerce')
df_clean = df_clean.dropna(subset=['order_time']).copy()
n_invalid_time = n_before - len(df_clean)

df_clean['order_month'] = df_clean['order_time'].dt.month
df_clean['order_dayofweek'] = df_clean['order_time'].dt.dayofweek
df_clean['order_hour'] = df_clean['order_time'].dt.hour
df_clean = df_clean.drop(columns=['order_time'])

# Encoding variabel target: 0 = Tidak Batal, 1 = Batal
status_norm = df_clean['order_status'].astype(str).str.strip().str.lower()
df_clean['target'] = status_norm.isin(['batal', 'cancelled', 'canceled']).astype(int)
df_clean = df_clean.drop(columns=['order_status'])

print(f'Baris dengan timestamp tidak valid yang dihapus : {n_invalid_time}')
print('\nDistribusi Kelas Target (0 = Tidak Batal, 1 = Batal):')
print(df_clean['target'].value_counts())
print(f"Proporsi kelas Batal: {df_clean['target'].mean() * 100:.2f}%")

# Memisahkan Fitur (X) dan Target (y)
X = df_clean.drop(columns=['target'])
y = df_clean['target']

num_cols = X.select_dtypes(include=['int64', 'float64', 'int32', 'float32']).columns.tolist()
cat_cols = X.select_dtypes(include=['object', 'category']).columns.tolist()

print('\nFitur numerik     :', num_cols)
print('Fitur kategorikal :', cat_cols)

# Imputasi Missing Values
num_imputer = None
if len(num_cols) > 0:
    num_imputer = SimpleImputer(strategy='median')
    X[num_cols] = num_imputer.fit_transform(X[num_cols])

cat_imputer = None
if len(cat_cols) > 0:
    cat_imputer = SimpleImputer(strategy='most_frequent')
    X[cat_cols] = cat_imputer.fit_transform(X[cat_cols])

# Encoding Fitur Kategorikal & Menyimpan Objek LabelEncoder Asli
label_encoders = {}
for col in cat_cols:
    le = LabelEncoder()
    X[col] = le.fit_transform(X[col].astype(str))
    label_encoders[col] = le

# Train-Test Split (80:20 Stratified)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

# Standarisasi Fitur dengan StandardScaler
scaler = StandardScaler()
X_train_scaled = pd.DataFrame(scaler.fit_transform(X_train), columns=X.columns)
X_test_scaled = pd.DataFrame(scaler.transform(X_test), columns=X.columns)

# Penyeimbangan Kelas pada Data Latih dengan SMOTE
smote = SMOTE(random_state=42)
X_train_res, y_train_res = smote.fit_resample(X_train_scaled, y_train)

print('\n=== RINGKASAN DATA PREPROCESSING ===')
print(f'Jumlah Data Latih (Sebelum SMOTE) : {X_train_scaled.shape[0]} sampel')
print(f'Jumlah Data Latih (Sesudah SMOTE) : {X_train_res.shape[0]} sampel')
print(f'Jumlah Data Uji (Test Set)        : {X_test_scaled.shape[0]} sampel')
print(f'Jumlah Fitur                      : {X.shape[1]}')

# ============================================================
# 2. TAHAP 2: PEMODELAN & HYPERPARAMETER TUNING
# ============================================================
cv_strategy = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

print('\n1. Melatih KNN Baseline & GridSearchCV...')
knn_base = KNeighborsClassifier()
knn_base.fit(X_train_res, y_train_res)

param_grid_knn = {
    'n_neighbors': [5, 9, 15],
    'weights': ['uniform', 'distance'],
    'metric': ['euclidean', 'manhattan']
}
grid_knn = GridSearchCV(
    KNeighborsClassifier(), param_grid_knn,
    cv=cv_strategy, scoring='f1', n_jobs=-1, verbose=1
)
grid_knn.fit(X_train_res, y_train_res)
knn_tuned = grid_knn.best_estimator_
print('Best Params KNN:', grid_knn.best_params_)

print('\n2. Melatih Random Forest Baseline & GridSearchCV...')
rf_base = RandomForestClassifier(random_state=42, n_jobs=-1)
rf_base.fit(X_train_res, y_train_res)

param_grid_rf = {
    'n_estimators': [100, 200],
    'max_depth': [8, 12, 16],
    'min_samples_split': [5, 10],
    'min_samples_leaf': [2, 4]
}
grid_rf = GridSearchCV(
    RandomForestClassifier(random_state=42), param_grid_rf,
    cv=cv_strategy, scoring='f1', n_jobs=-1, verbose=1
)
grid_rf.fit(X_train_res, y_train_res)
rf_tuned = grid_rf.best_estimator_
print('Best Params Random Forest:', grid_rf.best_params_)

print('\n3. Melatih XGBoost Baseline & GridSearchCV...')
xgb_base = XGBClassifier(random_state=42, eval_metric='logloss', n_jobs=-1)
xgb_base.fit(X_train_res, y_train_res)

param_grid_xgb = {
    'n_estimators': [100, 200],
    'max_depth': [4, 6],
    'learning_rate': [0.05, 0.1],
    'subsample': [0.8, 1.0]
}
grid_xgb = GridSearchCV(
    XGBClassifier(random_state=42, eval_metric='logloss', n_jobs=-1), param_grid_xgb,
    cv=cv_strategy, scoring='f1', n_jobs=-1, verbose=1
)
grid_xgb.fit(X_train_res, y_train_res)
xgb_tuned = grid_xgb.best_estimator_
print('Best Params XGBoost:', grid_xgb.best_params_)

# ============================================================
# 3. TAHAP 3: EVALUASI MODEL & VISUALISASI
# ============================================================
models = {
    'KNN (Baseline)': knn_base,
    'KNN (Tuned)': knn_tuned,
    'Random Forest (Baseline)': rf_base,
    'Random Forest (Tuned)': rf_tuned,
    'XGBoost (Baseline)': xgb_base,
    'XGBoost (Tuned)': xgb_tuned
}

eval_results = []
for name, model in models.items():
    y_train_pred = model.predict(X_train_scaled)
    y_test_pred = model.predict(X_test_scaled)
    y_test_prob = model.predict_proba(X_test_scaled)[:, 1]

    train_acc = accuracy_score(y_train, y_train_pred)
    test_acc = accuracy_score(y_test, y_test_pred)
    gap = abs(train_acc - test_acc)
    prec = precision_score(y_test, y_test_pred, zero_division=0)
    rec = recall_score(y_test, y_test_pred, zero_division=0)
    f1 = f1_score(y_test, y_test_pred, zero_division=0)
    auc = roc_auc_score(y_test, y_test_prob)

    status = 'Goodfit' if gap <= 0.04 and test_acc >= 0.80 else ('Overfitting' if gap > 0.08 else 'Cukup Stabil')

    eval_results.append({
        'Model': name,
        'Train Accuracy (%)': round(train_acc * 100, 2),
        'Test Accuracy (%)': round(test_acc * 100, 2),
        'Gap (%)': round(gap * 100, 2),
        'Precision (%)': round(prec * 100, 2),
        'Recall (%)': round(rec * 100, 2),
        'F1-Score (%)': round(f1 * 100, 2),
        'ROC-AUC (%)': round(auc * 100, 2),
        'Status Fit': status
    })

df_eval = pd.DataFrame(eval_results)
print('\n=== TABEL REKAPITULASI EVALUASI MODEL ===')
display(df_eval)

# Visualisasi 1: Confusion Matrix
fig, axes = plt.subplots(1, 3, figsize=(18, 5))
tuned_models = [
    ('KNN (Tuned)', knn_tuned),
    ('Random Forest (Tuned)', rf_tuned),
    ('XGBoost (Tuned)', xgb_tuned)
]
for ax, (title, model) in zip(axes, tuned_models):
    cm = confusion_matrix(y_test, model.predict(X_test_scaled))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=ax, cbar=False)
    ax.set_title(f'Confusion Matrix - {title}', fontweight='bold')
    ax.set_xlabel('Predicted Label')
    ax.set_ylabel('True Label')
plt.tight_layout()
plt.savefig('confusion_matrix_perbandingan.png', dpi=300)
plt.show()

# Visualisasi 2: Perbandingan Train vs Test Accuracy
plt.figure(figsize=(11, 5))
x_idx = np.arange(len(df_eval['Model']))
width = 0.35
plt.bar(x_idx - width/2, df_eval['Train Accuracy (%)'], width, label='Train Accuracy (%)', color='#2b5c8f')
plt.bar(x_idx + width/2, df_eval['Test Accuracy (%)'], width, label='Test Accuracy (%)', color='#36a2eb')
plt.xticks(x_idx, df_eval['Model'], rotation=20)
plt.ylabel('Accuracy (%)')
plt.title('Perbandingan Train Accuracy vs Test Accuracy (Evaluasi Goodfit)', fontweight='bold')
y_min = min(df_eval['Train Accuracy (%)'].min(), df_eval['Test Accuracy (%)'].min())
plt.ylim(max(0, y_min - 10), 102)
plt.legend()
plt.tight_layout()
plt.savefig('perbandingan_goodfit_accuracy.png', dpi=300)
plt.show()

# Visualisasi 3: Feature Importance XGBoost Tuned
importances = pd.Series(xgb_tuned.feature_importances_, index=X.columns)
plt.figure(figsize=(10, 6))
importances.nlargest(10).sort_values().plot(kind='barh', color='#1f77b4')
plt.title('Top 10 Feature Importance - XGBoost (Tuned)', fontweight='bold')
plt.xlabel('Relative Importance Score')
plt.tight_layout()
plt.savefig('feature_importance_xgboost.png', dpi=300)
plt.show()

# ============================================================
# 4. RINGKASAN OTOMATIS MODEL GOODFIT TERBAIK
# ============================================================
kandidat_goodfit = df_eval[df_eval['Status Fit'] == 'Goodfit']

if len(kandidat_goodfit) > 0:
    best_row = kandidat_goodfit.sort_values('F1-Score (%)', ascending=False).iloc[0]
    print('Model Goodfit terbaik :', best_row['Model'])
else:
    best_row = df_eval.sort_values('F1-Score (%)', ascending=False).iloc[0]
    print('Tidak ada model yang memenuhi kriteria Goodfit (gap <= 4% dan Test Accuracy >= 80%).')
    print('Model dengan F1-Score tertinggi:', best_row['Model'])

print(f"Train Accuracy : {best_row['Train Accuracy (%)']}%")
print(f"Test Accuracy  : {best_row['Test Accuracy (%)']}%")
print(f"Gap            : {best_row['Gap (%)']}%")
print(f"Precision      : {best_row['Precision (%)']}%")
print(f"Recall         : {best_row['Recall (%)']}%")
print(f"F1-Score       : {best_row['F1-Score (%)']}%")
print(f"ROC-AUC        : {best_row['ROC-AUC (%)']}%")
print(f"Status Fit     : {best_row['Status Fit']}")

# ============================================================
# 5. EKSPOR & DOWNLOAD MODEL (.pth) UNTUK DEPLOYMENT APLIKASI
# ============================================================
best_model_name = best_row['Model']
best_model_obj = models[best_model_name]
num_defaults = {col: float(X[col].median()) for col in num_cols}

model_bundle = {
    'model_name': best_model_name,
    'model': best_model_obj,
    'scaler': scaler,
    'num_imputer': num_imputer,
    'cat_imputer': cat_imputer,
    'label_encoders': label_encoders,
    'feature_columns': list(X.columns),
    'num_cols': num_cols,
    'cat_cols': cat_cols,
    'num_defaults': num_defaults,
    'metrics': best_row.to_dict()
}

pth_filename = 'model_ecommerce_ganang.pth'
torch.save(model_bundle, pth_filename)

print("\n" + "=" * 60)
print(f"✅ Model '{best_model_name}' berhasil disimpan ke: {pth_filename}")
print("=" * 60)

try:
    from google.colab import files
    files.download(pth_filename)
except Exception as e:
    print("Download otomatis hanya berjalan di Google Colab:", e)
